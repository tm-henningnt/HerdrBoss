# Herdr Boss orchestration rules. Save as ~/.codex/rules/herdr.rules.
prefix_rule(pattern=["ps"], decision="allow")
prefix_rule(pattern=["launchctl", "kickstart", "-k", "gui/{{UID}}/no.tallmaker.herdr-boss"], decision="allow")
prefix_rule(pattern=["herdr-boss", "browser"], decision="allow")
# A worker stops its own process through the helper, never with a raw signal.
prefix_rule(pattern=["herdr-boss", "worker", "stop-own"], decision="allow")
prefix_rule(pattern=["playwright-cli"], decision="allow")
# Never print the environment of another process.
prefix_rule(pattern=["ps", "e"], decision="forbidden")
prefix_rule(pattern=["ps", "-E"], decision="forbidden")
prefix_rule(pattern=["ps", "eww"], decision="forbidden")
prefix_rule(pattern=["ps", "auxe"], decision="forbidden")
prefix_rule(pattern=["ps", "auxeww"], decision="forbidden")
# Stop only processes you started, by their saved PID. A name pattern can stop another project's process.
prefix_rule(pattern=["pkill"], decision="forbidden")
prefix_rule(pattern=["killall"], decision="forbidden")
