{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "herdr-boss.project-type/1",
  "title": "Herdr Boss project type manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "version",
    "default",
    "templateRepository",
    "setupSteps",
    "templates",
    "agentsSections",
    "gates",
    "trackerPreset",
    "releaseFlow",
    "settings",
    "checks",
    "requiredInputs",
    "licenseMode"
  ],
  "properties": {
    "schema": { "const": "herdr-boss.project-type/1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "default": { "type": "boolean" },
    "templateRepository": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["url", "revision"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "setupSteps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "operation"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "operation": { "type": "string", "enum": ["copy-template", "write-agent-sections", "apply-settings"] }
        }
      }
    },
    "templates": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "agentsSections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "heading"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "file": { "type": "string", "minLength": 1 },
          "heading": { "type": "string", "minLength": 1 }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "expectedOutput"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "command": { "type": "string", "minLength": 1 },
          "expectedOutput": { "type": "string", "minLength": 1 }
        }
      }
    },
    "trackerPreset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["triageLabels", "stateLabels"],
      "properties": {
        "triageLabels": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "stateLabels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["open", "inProgress", "blocked", "done"],
          "properties": {
            "open": { "type": "string", "minLength": 1 },
            "inProgress": { "type": "string", "minLength": 1 },
            "blocked": { "type": "string", "minLength": 1 },
            "done": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "releaseFlow": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["repository", "approvalStep", "scanRules", "assets", "checklist"],
      "properties": {
        "repository": { "type": ["string", "null"], "minLength": 1 },
        "approvalStep": { "type": "string", "minLength": 1 },
        "scanRules": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "assets": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "checklist": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type", "default", "projectEditable"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "enum": ["string", "boolean", "number", "object", "array"] },
          "default": {},
          "projectEditable": { "type": "boolean" }
        }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "files", "script", "settings", "versions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "files": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "script": { "type": ["string", "null"], "minLength": 1 },
          "settings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "versions": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "requiredInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "required", "destination"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "kind": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "destination": { "type": "string", "minLength": 1 }
        }
      }
    },
    "licenseMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "default"],
      "properties": {
        "values": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "default": { "type": "string", "minLength": 1 }
      }
    }
  }
}
