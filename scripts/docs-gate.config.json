{
  "behavior": [
    "src/**",
    "public/**",
    "bin/**",
    "factory/**",
    "kit/**"
  ],
  "behaviorIgnore": [
    "kit/CHANGES.md"
  ],
  "docs": [
    "docs/**",
    "README.md"
  ],
  "docsIgnore": [
    "docs/orchestration/**",
    "docs/plans/**",
    "docs/tickets/**",
    "docs/ideas/**",
    "docs/spikes/**",
    "docs/gate-exemptions"
  ],
  "tokens": [
    "src/**",
    "kit/**",
    "scripts/**",
    "examples/**",
    "*",
    "public/**",
    "bin/**",
    "factory/**",
    "release/**",
    "releases/**",
    "dist/**",
    "build/**",
    "demo/**",
    "demos/**",
    "**/fixture/**",
    "**/fixtures/**",
    "**/__fixtures__/**",
    "fixture/**",
    "fixtures/**",
    "__fixtures__/**",
    "test-app/**",
    "test-apps/**",
    "test/fixtures/**",
    "test/apps/**",
    "test/demos/**",
    "test/*.test.js"
  ],
  "exemptionFile": "docs/gate-exemptions",
  "tokenAllowlist": "scripts/docs-gate-allowlist.json"
}
