{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example/factories/1.0.0/schema/common.v1.schema.json",
  "title": "Factory contract value types",
  "version": "1.0.0",
  "description": "Version 1.0.0. See docs/contracts/factories.md for producers, consumers, and refusal rules.",
  "$defs": {
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$(?![\\s\\S])"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$(?![\\s\\S])"
    },
    "timestamp": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$(?![\\s\\S])"
    },
    "day": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10,
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$(?![\\s\\S])"
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)+$(?![\\s\\S])"
    },
    "dashboardUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^https?://[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?(?::[0-9]{1,5})?/?$(?![\\s\\S])"
    },
    "kitRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{12,64}$(?![\\s\\S])"
    },
    "digest": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
    },
    "commit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-f0-9]{40}$(?![\\s\\S])"
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "harness": {
      "enum": [
        "claude",
        "codex",
        "opencode"
      ]
    },
    "state": {
      "enum": [
        "ready",
        "doing",
        "review",
        "blocked",
        "done",
        "paused",
        "unknown"
      ]
    },
    "contractVersion": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^1\\.[0-9]+\\.[0-9]+$(?![\\s\\S])"
    }
  }
}
