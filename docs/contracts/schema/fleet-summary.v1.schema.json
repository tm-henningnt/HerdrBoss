{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example/factories/1.0.0/schema/fleet-summary.v1.schema.json",
  "title": "Fleet summary",
  "version": "1.2.0",
  "description": "Version 1.2.0. See docs/contracts/factories.md for producers, consumers, and refusal rules.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1
    },
    "contractVersion": {
      "$ref": "common.v1.schema.json#/$defs/contractVersion"
    },
    "factoryId": {
      "$ref": "common.v1.schema.json#/$defs/slug"
    },
    "name": {
      "$ref": "common.v1.schema.json#/$defs/slug"
    },
    "version": {
      "$ref": "common.v1.schema.json#/$defs/version"
    },
    "kitRevision": {
      "$ref": "common.v1.schema.json#/$defs/kitRevision"
    },
    "commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{7,40}$"
    },
    "startedAt": {
      "oneOf": [
        {
          "$ref": "common.v1.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "generatedAt": {
      "$ref": "common.v1.schema.json#/$defs/timestamp"
    },
    "dashboardUrl": {
      "$ref": "common.v1.schema.json#/$defs/dashboardUrl"
    },
    "kind": {
      "enum": [
        "native",
        "container",
        null
      ]
    },
    "health": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "healthy",
            "degraded",
            "offline",
            "unknown"
          ]
        },
        "tickAgeSeconds": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "herdrReachable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "clockOffsetSeconds": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "status",
        "tickAgeSeconds",
        "herdrReachable",
        "clockOffsetSeconds"
      ],
      "additionalProperties": false
    },
    "machine": {
      "type": "object",
      "properties": {
        "load1": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "load5": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "load15": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "cpus": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "memoryTotalMb": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "memoryFreePercent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "swapUsedMb": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "diskFreePercent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "diskFreeMb": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "utcOffsetMinutes": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "load1",
        "load5",
        "load15",
        "cpus",
        "memoryTotalMb",
        "memoryFreePercent",
        "swapUsedMb"
      ],
      "additionalProperties": false
    },
    "workers": {
      "type": "object",
      "properties": {
        "running": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "running",
        "max"
      ],
      "additionalProperties": false
    },
    "claudeUsageHelper": {
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "state": {
              "const": "installed"
            },
            "lastReadingSeconds": {
              "$ref": "common.v1.schema.json#/$defs/count"
            }
          },
          "required": [
            "state",
            "lastReadingSeconds"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "state": {
              "const": "not-installed"
            },
            "reason": {
              "enum": [
                "setting-off",
                "different-statusline",
                "settings-unreadable",
                "no-reading"
              ]
            }
          },
          "required": [
            "state",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "harnesses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "harness": {
            "$ref": "common.v1.schema.json#/$defs/harness"
          },
          "login": {
            "enum": [
              "ok",
              "expired",
              "unknown"
            ]
          },
          "checkedAt": {
            "oneOf": [
              {
                "$ref": "common.v1.schema.json#/$defs/timestamp"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "harness",
          "login",
          "checkedAt"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "boss": {
      "type": "object",
      "properties": {
        "running": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "harness": {
          "oneOf": [
            {
              "$ref": "common.v1.schema.json#/$defs/harness"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "running",
        "harness"
      ],
      "additionalProperties": false
    },
    "pending": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "$ref": "common.v1.schema.json#/$defs/slug"
          },
          "since": {
            "oneOf": [
              {
                "$ref": "common.v1.schema.json#/$defs/timestamp"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "step",
          "since"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "backup": {
      "type": "object",
      "properties": {
        "lastAt": {
          "oneOf": [
            {
              "$ref": "common.v1.schema.json#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "lastAt"
      ],
      "additionalProperties": false
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "$ref": "common.v1.schema.json#/$defs/slug"
          },
          "phase": {
            "$ref": "common.v1.schema.json#/$defs/slug"
          },
          "status": {
            "$ref": "common.v1.schema.json#/$defs/state"
          },
          "statusAgeSeconds": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "kitRevision": {
            "$ref": "common.v1.schema.json#/$defs/kitRevision"
          },
          "board": {
            "type": "object",
            "properties": {
              "doing": {
                "$ref": "common.v1.schema.json#/$defs/count"
              },
              "review": {
                "$ref": "common.v1.schema.json#/$defs/count"
              },
              "blocked": {
                "$ref": "common.v1.schema.json#/$defs/count"
              },
              "done7d": {
                "$ref": "common.v1.schema.json#/$defs/count"
              }
            },
            "required": [
              "doing",
              "review",
              "blocked",
              "done7d"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "slug",
          "phase",
          "status",
          "statusAgeSeconds",
          "kitRevision",
          "board"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "quotas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "harness": {
            "$ref": "common.v1.schema.json#/$defs/harness"
          },
          "accountKey": {
            "$ref": "common.v1.schema.json#/$defs/digest"
          },
          "accountScope": {
            "enum": [
              "this-factory"
            ]
          },
          "lane": {
            "$ref": "common.v1.schema.json#/$defs/slug"
          },
          "usedPercent": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "resetAt": {
            "oneOf": [
              {
                "$ref": "common.v1.schema.json#/$defs/timestamp"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "ok",
              "ahead",
              "exhausted",
              "unknown"
            ]
          },
          "estimate": {
            "type": "object",
            "properties": {
              "days": {
                "$ref": "common.v1.schema.json#/$defs/count",
                "minimum": 1
              },
              "tokens": {
                "$ref": "common.v1.schema.json#/$defs/count"
              },
              "costUsd": {
                "type": "number",
                "minimum": 0
              },
              "omittedModels": {
                "$ref": "common.v1.schema.json#/$defs/count"
              }
            },
            "required": [
              "days",
              "tokens",
              "costUsd",
              "omittedModels"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "harness",
          "lane",
          "usedPercent",
          "resetAt",
          "status"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "accountKey"
            ],
            "properties": {
              "accountScope": false
            }
          },
          {
            "required": [
              "accountScope"
            ],
            "properties": {
              "accountKey": false
            }
          }
        ]
      },
      "minItems": 0
    },
    "spend": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "$ref": "common.v1.schema.json#/$defs/day"
          },
          "role": {
            "enum": [
              "boss",
              "orchestrator",
              "worker"
            ]
          },
          "harness": {
            "$ref": "common.v1.schema.json#/$defs/harness"
          },
          "usd": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        },
        "required": [
          "day",
          "role",
          "harness",
          "usd"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "$ref": "common.v1.schema.json#/$defs/slug"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "projectSlug": {
            "$ref": "common.v1.schema.json#/$defs/slug"
          }
        },
        "required": [
          "code",
          "severity"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "shareItemTitles": {
      "type": "boolean"
    },
    "ownerItems": {
      "type": "object",
      "properties": {
        "total": {
          "$ref": "common.v1.schema.json#/$defs/count"
        },
        "needsOwner": {
          "$ref": "common.v1.schema.json#/$defs/count"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "common.v1.schema.json#/$defs/slug"
              },
              "projectSlug": {
                "$ref": "common.v1.schema.json#/$defs/slug"
              },
              "kind": {
                "enum": [
                  "decide",
                  "approve",
                  "answer"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            },
            "required": [
              "id",
              "kind"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "total",
        "needsOwner",
        "rows"
      ],
      "additionalProperties": false
    },
    "reviewPacks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.v1.schema.json#/$defs/slug"
          },
          "waitingItems": {
            "$ref": "common.v1.schema.json#/$defs/count"
          }
        },
        "required": [
          "id",
          "waitingItems"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema",
    "contractVersion",
    "factoryId",
    "name",
    "version",
    "kitRevision",
    "generatedAt",
    "dashboardUrl",
    "health",
    "machine",
    "projects",
    "quotas",
    "spend",
    "alerts",
    "shareItemTitles",
    "ownerItems",
    "reviewPacks"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "shareItemTitles": {
          "const": false
        },
        "ownerItems": {
          "type": "object",
          "properties": {
            "total": {
              "$ref": "common.v1.schema.json#/$defs/count"
            },
            "needsOwner": {
              "$ref": "common.v1.schema.json#/$defs/count"
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "common.v1.schema.json#/$defs/slug"
                  },
                  "kind": {
                    "enum": [
                      "decide",
                      "approve",
                      "answer"
                    ]
                  },
                  "projectSlug": {
                    "$ref": "common.v1.schema.json#/$defs/slug"
                  }
                },
                "required": [
                  "id",
                  "kind"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            }
          },
          "required": [
            "total",
            "needsOwner",
            "rows"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "properties": {
        "shareItemTitles": {
          "const": true
        },
        "ownerItems": {
          "type": "object",
          "properties": {
            "total": {
              "$ref": "common.v1.schema.json#/$defs/count"
            },
            "needsOwner": {
              "$ref": "common.v1.schema.json#/$defs/count"
            },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "common.v1.schema.json#/$defs/slug"
                  },
                  "kind": {
                    "enum": [
                      "decide",
                      "approve",
                      "answer"
                    ]
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "projectSlug": {
                    "$ref": "common.v1.schema.json#/$defs/slug"
                  }
                },
                "required": [
                  "id",
                  "kind"
                ],
                "additionalProperties": false
              },
              "minItems": 0
            }
          },
          "required": [
            "total",
            "needsOwner",
            "rows"
          ],
          "additionalProperties": false
        }
      }
    }
  ]
}
