{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.example/factories/1.0.0/schema/factory-registry.v1.schema.json",
  "title": "Factory registry",
  "version": "1.0.0",
  "description": "Version 1.0.0. See docs/contracts/factories.md for producers, consumers, and refusal rules.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1
    },
    "contractVersion": {
      "$ref": "common.v1.schema.json#/$defs/contractVersion"
    },
    "minimumFactoryVersion": {
      "$ref": "common.v1.schema.json#/$defs/version"
    },
    "hosts": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "hostId": {
                "$ref": "common.v1.schema.json#/$defs/slug"
              },
              "runtime": {
                "enum": [
                  "orbstack",
                  "colima",
                  "docker-engine",
                  "docker-engine-wsl2"
                ]
              },
              "personalOnly": {
                "type": "boolean"
              },
              "codexSandbox": {
                "enum": [
                  "user-namespaces",
                  "unconfined",
                  "unavailable"
                ]
              },
              "transport": {
                "const": "local"
              }
            },
            "required": [
              "hostId",
              "runtime",
              "personalOnly",
              "codexSandbox",
              "transport"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "hostId": {
                "$ref": "common.v1.schema.json#/$defs/slug"
              },
              "runtime": {
                "enum": [
                  "orbstack",
                  "colima",
                  "docker-engine",
                  "docker-engine-wsl2"
                ]
              },
              "personalOnly": {
                "type": "boolean"
              },
              "codexSandbox": {
                "enum": [
                  "user-namespaces",
                  "unconfined",
                  "unavailable"
                ]
              },
              "transport": {
                "const": "ssh"
              },
              "address": {
                "$ref": "common.v1.schema.json#/$defs/hostname"
              },
              "dockerContext": {
                "$ref": "common.v1.schema.json#/$defs/slug"
              }
            },
            "required": [
              "hostId",
              "runtime",
              "personalOnly",
              "codexSandbox",
              "transport",
              "address",
              "dockerContext"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 1
    },
    "factories": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "factoryId": {
                "$ref": "common.v1.schema.json#/$defs/slug"
              },
              "name": {
                "$ref": "common.v1.schema.json#/$defs/slug"
              },
              "hostId": {
                "$ref": "common.v1.schema.json#/$defs/slug"
              },
              "profile": {
                "enum": [
                  "personal",
                  "client"
                ]
              },
              "dashboardUrl": {
                "$ref": "common.v1.schema.json#/$defs/dashboardUrl"
              },
              "version": {
                "$ref": "common.v1.schema.json#/$defs/version"
              },
              "kitRevision": {
                "$ref": "common.v1.schema.json#/$defs/kitRevision"
              },
              "kind": {
                "const": "native"
              }
            },
            "required": [
              "factoryId",
              "name",
              "hostId",
              "profile",
              "dashboardUrl",
              "version",
              "kitRevision",
              "kind"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "factoryId": {
                "$ref": "common.v1.schema.json#/$defs/slug"
              },
              "name": {
                "$ref": "common.v1.schema.json#/$defs/slug"
              },
              "hostId": {
                "$ref": "common.v1.schema.json#/$defs/slug"
              },
              "profile": {
                "enum": [
                  "personal",
                  "client"
                ]
              },
              "dashboardUrl": {
                "$ref": "common.v1.schema.json#/$defs/dashboardUrl"
              },
              "version": {
                "$ref": "common.v1.schema.json#/$defs/version"
              },
              "kitRevision": {
                "$ref": "common.v1.schema.json#/$defs/kitRevision"
              },
              "kind": {
                "const": "container"
              },
              "containerName": {
                "type": "string",
                "minLength": 1,
                "maxLength": 67,
                "pattern": "^hf-[a-z][a-z0-9-]*$(?![\\s\\S])"
              },
              "ports": {
                "type": "object",
                "properties": {
                  "dashboard": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "ssh": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  }
                },
                "required": [
                  "dashboard",
                  "ssh"
                ],
                "additionalProperties": false
              },
              "image": {
                "type": "object",
                "properties": {
                  "builtAt": {
                    "$ref": "common.v1.schema.json#/$defs/timestamp"
                  },
                  "pinsHash": {
                    "$ref": "common.v1.schema.json#/$defs/digest"
                  }
                },
                "required": [
                  "builtAt",
                  "pinsHash"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "factoryId",
              "name",
              "hostId",
              "profile",
              "dashboardUrl",
              "version",
              "kitRevision",
              "kind",
              "containerName",
              "ports",
              "image"
            ],
            "additionalProperties": false
          }
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schema",
    "contractVersion",
    "minimumFactoryVersion",
    "hosts",
    "factories"
  ],
  "additionalProperties": false
}
